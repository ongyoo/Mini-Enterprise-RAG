# Copy to .env and fill in. Never commit real values.
APP_ENV=local

# openai | azure | anthropic | fake (fake = offline, no API key, plumbing only)
LLM_PROVIDER=anthropic
# openai | azure | local | hashing. Empty = follow LLM_PROVIDER (anthropic=local, fake=hashing)
EMBEDDING_PROVIDER=

OPENAI_API_KEY=
# Any supported chat model with structured output
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-opus-5-5
# low | medium | high
ANTHROPIC_EFFORT=low

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Must match the embedding model (openai 1536, local mpnet 768). Changing it needs `docker compose down -v` and a re-ingest
EMBEDDING_DIMENSIONS=768
DATABASE_URL=postgresql+psycopg://app:local_password@localhost:5432/rag

RAG_TOP_K=5
# Uncalibrated starting point; tune with `make eval`. Use ~0.3 with hashing embeddings
RAG_SIMILARITY_THRESHOLD=0.28
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2

LOG_RAW_QUERIES=false
AUDIT_HASH_SALT=change-me-to-a-long-random-string
